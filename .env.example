# Copy to .env on the host and fill in. .env is gitignored and must stay that way.
#   cp .env.example .env && chmod 600 .env
# Every variable docker-compose.yml uses must be listed here (enforced by tests/unit).

# --- General -----------------------------------------------------------------
TZ=Europe/Berlin

# --- Media ownership -----------------------------------------------------------
# User and group that own /data. Must match the owner of the media volume
# (scripts/host/bootstrap.sh creates it) and the user Jellyfin reads as.
PUID=1000
PGID=1000
# 002 = files 664, dirs 775: group-writable so the app, qBittorrent and Jellyfin share files.
UMASK=002

# --- Storage -------------------------------------------------------------------
# Mount point of the media volume. downloads/ and the library folders below live on ONE
# filesystem so hardlinks work (layout: docs/host-setup.md, step 4b).
DATA_ROOT=/data

# Library folder per media type, relative to DATA_ROOT. These are the folders Jellyfin's
# libraries point at; the names are the owner's existing German ones. "ö" and "ü" are
# fine, but must match the folder names on disk exactly. Downloads never go here
# directly: they go to DATA_ROOT/downloads/{movies,series,audiobooks,music} and are
# hardlinked into these when finished.
MEDIA_DIR_MOVIES=Filme
MEDIA_DIR_SERIES=Serien
MEDIA_DIR_AUDIOBOOKS=Hörbücher
MEDIA_DIR_MUSIC=Musik
MEDIA_DIR_YOUTUBE=Youtube

# --- Network -------------------------------------------------------------------
# Home LAN in CIDR notation; gluetun lets this subnet through its firewall.
LAN_SUBNET=192.168.178.0/24
# Where the qBittorrent Web UI is published. Keep 127.0.0.1 until the reverse proxy (#9) exists.
QBIT_WEBUI_BIND=127.0.0.1
QBIT_WEBUI_PORT=8080

# --- VPN (gluetun) -------------------------------------------------------------
# Provider and type. ExpressVPN works with OPENVPN ONLY (no WireGuard, no Lightway).
# Only the variables of the chosen VPN_TYPE are read; the other block can stay as is.
#
# VPN_SERVICE_PROVIDER=custom uses ExpressVPN's OWN .ovpn file instead of gluetun's
# built-in "expressvpn" provider. As of 2026-11 (gluetun v3.41.3) the built-in provider
# is broken: every server fails with "TLS key negotiation failed", because the key
# embedded in gluetun is stale. Re-check when GLUETUN_TAG is updated (#30); until the
# built-in provider works again, keep "custom".
#   1. Save ExpressVPN's OpenVPN config as config/expressvpn.ovpn (chmod 600, never commit).
#   2. make vpn-config   (resolves its server name to an IP, which gluetun requires)
#   3. make up           (does step 2 again, then docker compose up -d)
# With "custom", VPN_SERVER_COUNTRIES / VPN_SERVER_CITIES must stay empty: the server is
# the one named in the file. To go back to the built-in provider, set
# VPN_SERVICE_PROVIDER=expressvpn and leave OPENVPN_CUSTOM_CONFIG empty.
VPN_SERVICE_PROVIDER=custom
OPENVPN_CUSTOM_CONFIG=/gluetun/custom/expressvpn.ovpn
VPN_TYPE=openvpn

# OpenVPN: ExpressVPN "manual configuration" credentials (account page > Set up on
# more devices > Manual configuration > OpenVPN). NOT your e-mail and password.
OPENVPN_USER=changeme
OPENVPN_PASSWORD=changeme

# WireGuard (only with VPN_TYPE=wireguard and a provider that offers it).
WIREGUARD_PRIVATE_KEY=changeme
WIREGUARD_ADDRESSES=10.0.0.2/32

# Where to connect with a BUILT-IN provider. Optional, comma separated; empty = any server.
# Leave both empty with VPN_SERVICE_PROVIDER=custom.
# Names must match gluetun's server list for the provider, e.g. Germany / Frankfurt.
VPN_SERVER_COUNTRIES=
VPN_SERVER_CITIES=

# ExpressVPN does not offer port forwarding, so there are no incoming peers through the
# VPN: torrents still download, but with fewer peers. Do not add VPN_PORT_FORWARDING.

# --- Jellyfin (external) ---------------------------------------------------------
# Jellyfin runs in its own LXC, not in this stack. The app calls its API to refresh a
# library after a download. How to create the key: docs/jellyfin.md.
# NOTE: the port is not confirmed yet (8096 is Jellyfin's default); check it in the LXC.
JELLYFIN_URL=http://192.168.178.108:8096
# Secret. Dashboard > API Keys > "+". Put it only in your .env on the VM, never in Git.
JELLYFIN_API_KEY=

# --- Image tags ------------------------------------------------------------------
# Pin these to explicit versions on the host; update deliberately (#30).
GLUETUN_TAG=v3.41.3
QBITTORRENT_TAG=latest
CADDY_TAG=2
