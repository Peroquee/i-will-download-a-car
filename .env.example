# Copy to .env on the host and fill in. .env is gitignored and must stay that way.
#   cp .env.example .env && chmod 600 .env
# Every variable docker-compose.yml uses must be listed here (enforced by tests/unit).

# --- General -----------------------------------------------------------------
TZ=Europe/Berlin

# --- Media ownership -----------------------------------------------------------
# User and group that own /data. Must match the owner of the media volume
# (scripts/host/bootstrap.sh creates it) and the user Jellyfin reads as.
PUID=1000
PGID=1000
# 002 = files 664, dirs 775: group-writable so the app, qBittorrent and Jellyfin share files.
UMASK=002

# --- Storage -------------------------------------------------------------------
# Mount point of the media volume. downloads/ and media/ live below it on ONE
# filesystem so hardlinks work (layout in #5).
DATA_ROOT=/data

# --- Network -------------------------------------------------------------------
# Home LAN in CIDR notation; gluetun lets this subnet through its firewall.
LAN_SUBNET=192.168.178.0/24
# Where the qBittorrent Web UI is published. Keep 127.0.0.1 until the reverse proxy (#9) exists.
QBIT_WEBUI_BIND=127.0.0.1
QBIT_WEBUI_PORT=8080

# --- VPN (gluetun) -------------------------------------------------------------
# Provider and type. ExpressVPN works with OPENVPN ONLY (no WireGuard, no Lightway).
# Only the variables of the chosen VPN_TYPE are read; the other block can stay as is.
VPN_SERVICE_PROVIDER=expressvpn
VPN_TYPE=openvpn

# OpenVPN: ExpressVPN "manual configuration" credentials (account page > Set up on
# more devices > Manual configuration > OpenVPN). NOT your e-mail and password.
OPENVPN_USER=changeme
OPENVPN_PASSWORD=changeme

# WireGuard (only with VPN_TYPE=wireguard and a provider that offers it).
WIREGUARD_PRIVATE_KEY=changeme
WIREGUARD_ADDRESSES=10.0.0.2/32

# Where to connect. Optional, comma separated; empty = any server of the provider.
# Names must match gluetun's server list for the provider, e.g. Germany / Frankfurt.
VPN_SERVER_COUNTRIES=
VPN_SERVER_CITIES=

# ExpressVPN does not offer port forwarding, so there are no incoming peers through the
# VPN: torrents still download, but with fewer peers. Do not add VPN_PORT_FORWARDING.

# --- Image tags ------------------------------------------------------------------
# Pin these to explicit versions on the host; update deliberately (#30).
GLUETUN_TAG=v3.41.3
QBITTORRENT_TAG=latest
CADDY_TAG=2
JELLYFIN_TAG=latest
