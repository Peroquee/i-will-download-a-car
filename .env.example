# Copy to .env on the host and fill in. .env is gitignored and must stay that way.
#   cp .env.example .env && chmod 600 .env
# Every variable docker-compose.yml uses must be listed here (enforced by tests/unit).

# --- General -----------------------------------------------------------------
TZ=Europe/Berlin
# Log level of the app: DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO

# --- Media ownership -----------------------------------------------------------
# User and group that own /data. Must match the owner of the media volume
# (scripts/host/bootstrap.sh creates it) and the user Jellyfin reads as.
PUID=1000
PGID=1000
# 002 = files 664, dirs 775: group-writable so the app, qBittorrent and Jellyfin share files.
UMASK=002

# --- Storage -------------------------------------------------------------------
# Mount point of the media volume. downloads/ and the library folders below live on ONE
# filesystem so hardlinks work (layout: docs/host-setup.md, step 4b).
DATA_ROOT=/data

# Library folder per media type, relative to DATA_ROOT. These are the folders Jellyfin's
# libraries point at; the names are the owner's existing German ones. "ö" and "ü" are
# fine, but must match the folder names on disk exactly. Downloads never go here
# directly: they go to DATA_ROOT/downloads/{movies,series,audiobooks,music} and are
# hardlinked into these when finished.
MEDIA_DIR_MOVIES=Filme
MEDIA_DIR_SERIES=Serien
MEDIA_DIR_AUDIOBOOKS=Hörbücher
MEDIA_DIR_MUSIC=Musik
MEDIA_DIR_PODCASTS=Podcasts
MEDIA_DIR_YOUTUBE=Youtube

# Where `make backup` puts its archives (optional, normally left out). Default:
# <DATA_ROOT>/.youtube-premium-backups, on the media drive (created by scripts/host/create-layout.sh,
# mode 700, hidden, never indexed by Jellyfin; docs/operations.md). Set it only for another place,
# for example a NAS share that only you can read.
# YTP_BACKUP_DIR=

# --- Network -------------------------------------------------------------------
# Home LAN in CIDR notation; gluetun lets this subnet through its firewall.
LAN_SUBNET=192.168.178.0/24
# Where the qBittorrent Web UI is published by gluetun. Keep 127.0.0.1: the LAN reaches the
# Web UI through the reverse proxy below (this port stays for maintenance scripts on the VM).
QBIT_WEBUI_BIND=127.0.0.1
QBIT_WEBUI_PORT=8080

# --- Reverse proxy and login (#29, docs/proxy.md) -------------------------------------
# The proxy is the only way in from the LAN. It refuses clients outside LAN_SUBNET and asks
# for a login. Plain HTTP on the LAN is intended.
# The VM's own LAN address (an IPv4 address; run `hostname -I` on the VM). Compose refuses to
# start the proxy if the address is not on this machine. 0.0.0.0 would listen on every
# interface: don't, unless you know why.
PROXY_BIND=192.168.178.123
# The app answers here (http://<VM>:80/), the qBittorrent Web UI on the second port.
PROXY_PORT=80
PROXY_QBT_PORT=8081
# The login. Do not edit by hand: `make proxy-password` asks for the password and writes both
# lines (the hash is a bcrypt hash, kept in single quotes because it contains "$").
# "changeme" is a placeholder that matches no password; the proxy refuses everyone until
# you have run it.
PROXY_USER=admin
PROXY_PASSWORD_HASH=changeme

# --- VPN (gluetun) -------------------------------------------------------------
# Provider and type. ExpressVPN works with OPENVPN ONLY (no WireGuard, no Lightway).
# Only the variables of the chosen VPN_TYPE are read; the other block can stay as is.
#
# VPN_SERVICE_PROVIDER=custom uses ExpressVPN's OWN .ovpn file instead of gluetun's
# built-in "expressvpn" provider. As of 2026-11 (gluetun v3.41.3) the built-in provider
# is broken: every server fails with "TLS key negotiation failed", because the key
# embedded in gluetun is stale. Re-check when GLUETUN_TAG is updated (#30); until the
# built-in provider works again, keep "custom".
#   1. Save ExpressVPN's OpenVPN config as config/expressvpn.ovpn (chmod 600, never commit).
#   2. make vpn-config   (resolves its server name to an IP, which gluetun requires)
#   3. make up           (does step 2 again, then docker compose up -d)
# With "custom", VPN_SERVER_COUNTRIES / VPN_SERVER_CITIES must stay empty: the server is
# the one named in the file. To go back to the built-in provider, set
# VPN_SERVICE_PROVIDER=expressvpn and leave OPENVPN_CUSTOM_CONFIG empty.
VPN_SERVICE_PROVIDER=custom
OPENVPN_CUSTOM_CONFIG=/gluetun/custom/expressvpn.ovpn
VPN_TYPE=openvpn

# OpenVPN: ExpressVPN "manual configuration" credentials (account page > Set up on
# more devices > Manual configuration > OpenVPN). NOT your e-mail and password.
OPENVPN_USER=changeme
OPENVPN_PASSWORD=changeme

# WireGuard (only with VPN_TYPE=wireguard and a provider that offers it).
WIREGUARD_PRIVATE_KEY=changeme
WIREGUARD_ADDRESSES=10.0.0.2/32

# Where to connect with a BUILT-IN provider. Optional, comma separated; empty = any server.
# Leave both empty with VPN_SERVICE_PROVIDER=custom.
# Names must match gluetun's server list for the provider, e.g. Germany / Frankfurt.
VPN_SERVER_COUNTRIES=
VPN_SERVER_CITIES=

# ExpressVPN does not offer port forwarding, so there are no incoming peers through the
# VPN: torrents still download, but with fewer peers. Do not add VPN_PORT_FORWARDING.

# --- Jellyfin (external) ---------------------------------------------------------
# Jellyfin runs in its own LXC, not in this stack. The app calls its API to refresh a
# library after a download. How to create the key: docs/jellyfin.md.
JELLYFIN_URL=http://192.168.178.108:8096
# Secret. Dashboard > API Keys > "+". Put it only in your .env on the VM, never in Git.
JELLYFIN_API_KEY=

# --- qBittorrent login for the app (#10) --------------------------------------------
# The app logs in to qBittorrent's Web UI with the user and password you chose in
# scripts/qbittorrent/seed_config.py. The password is a secret: put it only in your .env on
# the VM, never in Git. Empty = the app starts but downloads are disabled (and says so).
QBIT_USER=admin
QBIT_PASSWORD=

# --- VPN watchdog (#21, docs/watchdog.md) ------------------------------------------
# A second layer behind gluetun's firewall: a separate container that pauses all torrents when
# the VPN drops. It reads the VPN status from gluetun's control server with its own read-only key:
# `make watchdog-key` creates the key, writes it here and writes gluetun's auth file. It also uses
# QBIT_PASSWORD above (required while the watchdog is part of the stack).
# "changeme" is a placeholder; until the key exists the watchdog reports itself unhealthy.
GLUETUN_CONTROL_APIKEY=changeme
# Seconds between polls, failed polls in a row before pausing, and seconds the VPN must stay
# up before paused torrents are resumed (0 = never resume automatically; you do it).
WATCHDOG_INTERVAL=1
WATCHDOG_THRESHOLD=3
WATCHDOG_RESUME_AFTER=0
# Alerts when the VPN goes down and when it is back (and when the watchdog cannot read the VPN
# status). EMPTY = off, which is the default: sending anything out of the LAN is your decision,
# so no public service is preset. ALERT_URL is a secret (an ntfy topic URL works like a password).
#   ntfy (self-hosted on the LAN, or any server you choose):  ALERT_URL=http://ntfy.lan/vpn-alerts
#   a generic webhook (Home Assistant, a script):  ALERT_URL=http://...  ALERT_FORMAT=webhook
# ALERT_TOKEN (optional) is sent as "Authorization: Bearer ...". Messages hold the state, time and
# reason only: never a password, key or IP address. See docs/watchdog.md.
ALERT_URL=
ALERT_TOKEN=
ALERT_FORMAT=ntfy
# The slow egress check (#23): every few minutes the watchdog asks gluetun for its public address
# (no third-party service) and checks it is public, is NOT your home line's, and (if set) is in the
# expected country; it also checks qBittorrent is bound to tun0. A confirmed mismatch alerts and
# pauses all torrents. 0 = off. HOME_PUBLIC_IP: your home line's public address(es) or IPv6
# prefix, separated by commas (never logged in full); see docs/watchdog.md for how to find it.
EGRESS_CHECK_INTERVAL=300
EGRESS_CONFIRM=2
HOME_PUBLIC_IP=
EGRESS_EXPECTED_COUNTRY=

# --- YouTube (#17, docs/youtube.md) -----------------------------------------------------
# yt-dlp asks YouTube THROUGH the VPN, via gluetun's HTTP proxy (inside the stack's network only).
# YouTube sometimes distrusts VPN addresses ("confirm you are not a bot"); if that becomes a
# nuisance, set this EMPTY to ask directly from the home line. The owner decides.
YTDLP_PROXY=http://gluetun:8888
# The tallest YouTube video to download, in pixels (H.264 + AAC in an mp4 is preferred); 0 = no limit.
# 1080 keeps a 10-minute video around 100 to 300 MB.
YOUTUBE_MAX_HEIGHT=1080
# How often the feed of each subscribed channel is looked at, in minutes (15 to 1440; 0 = never poll).
# Each channel gets its own slightly different interval, so they do not all go at once.
SUBSCRIPTION_POLL_MINUTES=60

# --- Magnet links (#40) -----------------------------------------------------------------
# Give up on a magnet link that has shown no progress for this many days (no sources: it never got
# its file list, or the download stopped for good). The job then fails with "no sources for 7 days",
# the torrent and its unfinished files are removed, and "Try again" in the job list adds it anew.
# Progress, a pause (also by the VPN watchdog) or downtime restarts the clock. 0 = never give up.
MAGNET_STALL_DAYS=7

# --- Automatic updates (#42, docs/autodeploy.md) ----------------------------------------------
# A timer on this machine looks every 5 minutes for a new version in GitLab and installs it only if
# its pipeline there is green and everything runs healthy (backup first, rollback if it fails).
# EMPTY = off. The address of the repository, without any login in it. The read-only token for it
# is NOT stored here but in config/autodeploy/token (the installer asks for it).
AUTODEPLOY_REMOTE=
AUTODEPLOY_BRANCH=main
# Seconds to wait for every service to be healthy after an update before it is rolled back.
AUTODEPLOY_HEALTH_WAIT=600

# --- Podcasts (#34, docs/podcasts.md) ---------------------------------------------------
# Feeds and episodes come from arbitrary hosts. They are fetched THROUGH the VPN (gluetun's HTTP
# proxy) and only from public addresses; a feed cannot make the app reach into the home network.
# Set this EMPTY to fetch directly from the home line (some podcast hosts block VPN addresses).
PODCAST_PROXY=http://gluetun:8888
# How often each subscribed podcast's feed is looked at, in minutes (30 to 1440; 0 = never poll).
PODCAST_POLL_MINUTES=240
# Networks that podcast fetches must never go to, comma-separated, in addition to the private
# ranges, HOME_PUBLIC_IP (above) and this host's own global IPv6 networks (found automatically).
# Needed for the home line's global IPv6 prefix (DS-Lite: the LAN has native global IPv6) if you
# fetch directly (PODCAST_PROXY empty). On the VM: `ip -6 addr show scope global`, e.g. 2003:abcd:1200::/56
FETCH_BLOCKED_NETWORKS=

# --- Image tags ------------------------------------------------------------------
# Pinned to explicit versions; there is no auto-update (no Watchtower: it needs the Docker socket,
# and a surprise update of the VPN gateway or of qBittorrent is exactly what we do not want).
# Update deliberately, one at a time, see docs/operations.md. `make update-check` lists what is in use.
GLUETUN_TAG=v3.41.3
# The exact build that runs on the media VM and passes tests/system (lscr.io/linuxserver/qbittorrent).
QBITTORRENT_TAG=5.3.0_v2.1.2-ls485
CADDY_TAG=2.10.2
