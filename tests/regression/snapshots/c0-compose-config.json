{
  "app": {
    "cap_add": [],
    "depends_on": {},
    "devices": [],
    "environment": {
      "JELLYFIN_API_KEY": "",
      "JELLYFIN_URL": "http://192.168.178.108:8096",
      "LOG_LEVEL": "INFO",
      "MEDIA_DIR_AUDIOBOOKS": "Hörbücher",
      "MEDIA_DIR_MOVIES": "Filme",
      "MEDIA_DIR_MUSIC": "Musik",
      "MEDIA_DIR_SERIES": "Serien",
      "MEDIA_DIR_YOUTUBE": "Youtube",
      "PGID": "1000",
      "PUID": "1000",
      "QBIT_PASSWORD": "",
      "QBIT_URL": "http://gluetun:8080",
      "QBIT_USER": "admin",
      "TZ": "Europe/Berlin",
      "UMASK": "002"
    },
    "healthcheck": null,
    "image": "youtube-premium/app:dev",
    "logging": {
      "driver": "json-file",
      "options": {
        "max-file": "3",
        "max-size": "10m"
      }
    },
    "network_mode": null,
    "ports": [],
    "profiles": [],
    "restart": "unless-stopped",
    "user": "1000:1000",
    "volumes": [
      "/data:/data",
      "<repo>/config/app:/config"
    ]
  },
  "gluetun": {
    "cap_add": [
      "NET_ADMIN"
    ],
    "depends_on": {},
    "devices": [
      "/dev/net/tun:/dev/net/tun"
    ],
    "environment": {
      "FIREWALL_OUTBOUND_SUBNETS": "192.168.178.0/24",
      "OPENVPN_CUSTOM_CONFIG": "/gluetun/custom/expressvpn.ovpn",
      "OPENVPN_PASSWORD": "changeme",
      "OPENVPN_USER": "changeme",
      "SERVER_CITIES": "",
      "SERVER_COUNTRIES": "",
      "TZ": "Europe/Berlin",
      "VPN_SERVICE_PROVIDER": "custom",
      "VPN_TYPE": "openvpn"
    },
    "healthcheck": {
      "interval": "10s",
      "retries": 3,
      "start_period": "1m0s",
      "test": [
        "CMD",
        "/gluetun-entrypoint",
        "healthcheck"
      ],
      "timeout": "5s"
    },
    "image": "qmcgaw/gluetun:v3.41.3",
    "logging": {
      "driver": "json-file",
      "options": {
        "max-file": "3",
        "max-size": "10m"
      }
    },
    "network_mode": null,
    "ports": [
      "127.0.0.1:8080:8080/tcp"
    ],
    "profiles": [],
    "restart": "unless-stopped",
    "user": null,
    "volumes": [
      "<repo>/config/gluetun:/gluetun"
    ]
  },
  "proxy": {
    "cap_add": [
      "NET_BIND_SERVICE"
    ],
    "depends_on": {
      "app": "service_healthy"
    },
    "devices": [],
    "environment": {
      "LAN_SUBNET": "192.168.178.0/24",
      "PROXY_PASSWORD_HASH": "changeme",
      "PROXY_USER": "admin"
    },
    "healthcheck": {
      "interval": "15s",
      "retries": 3,
      "start_period": "10s",
      "test": [
        "CMD",
        "wget",
        "-q",
        "-O",
        "/dev/null",
        "http://127.0.0.1:8082/health"
      ],
      "timeout": "5s"
    },
    "image": "caddy:2.10.2",
    "logging": {
      "driver": "json-file",
      "options": {
        "max-file": "3",
        "max-size": "10m"
      }
    },
    "network_mode": null,
    "ports": [
      "192.168.178.123:8081:8081/tcp",
      "192.168.178.123:80:8080/tcp"
    ],
    "profiles": [],
    "restart": "unless-stopped",
    "user": "1000:1000",
    "volumes": [
      "<repo>/proxy:/etc/caddy:ro"
    ]
  },
  "qbittorrent": {
    "cap_add": [],
    "depends_on": {
      "gluetun": "service_healthy"
    },
    "devices": [],
    "environment": {
      "PGID": "1000",
      "PUID": "1000",
      "TZ": "Europe/Berlin",
      "UMASK": "002",
      "WEBUI_PORT": "8080"
    },
    "healthcheck": {
      "interval": "30s",
      "retries": 3,
      "start_period": "1m0s",
      "test": [
        "CMD",
        "/custom-services.d/netwatch",
        "--check"
      ],
      "timeout": "5s"
    },
    "image": "lscr.io/linuxserver/qbittorrent:latest",
    "logging": {
      "driver": "json-file",
      "options": {
        "max-file": "3",
        "max-size": "10m"
      }
    },
    "network_mode": "service:gluetun",
    "ports": [],
    "profiles": [],
    "restart": "unless-stopped",
    "user": null,
    "volumes": [
      "/data:/data",
      "<repo>/config/qbittorrent:/config",
      "<repo>/scripts/qbittorrent/services:/custom-services.d:ro"
    ]
  },
  "watchdog": {
    "cap_add": [],
    "depends_on": {},
    "devices": [],
    "environment": {
      "TZ": "Europe/Berlin"
    },
    "healthcheck": null,
    "image": "youtube-premium/watchdog:dev",
    "logging": {
      "driver": "json-file",
      "options": {
        "max-file": "3",
        "max-size": "10m"
      }
    },
    "network_mode": null,
    "ports": [],
    "profiles": [
      "planned"
    ],
    "restart": "unless-stopped",
    "user": null,
    "volumes": []
  }
}
