# /etc/ytp-transcriber.env: settings of the Whisper worker (docs/transcription.md).
# install.sh copies this file there (mode 640, root:ytp-transcriber). Fill in the first two.

# The app, as the PC reaches it: the proxy address and port of the media VM (PROXY_BIND and
# PROXY_PORT in the app's .env). The PC must be in LAN_SUBNET, the proxy answers nobody else.
YTP_APP_URL=http://192.168.178.20:8080
# The same value as TRANSCRIBER_TOKEN in the app's .env.
TRANSCRIBER_TOKEN=changeme

# The model. large-v3-turbo: nearly the quality of large-v3 at several times the speed.
# large-v3 is a little better for difficult German audio and slower; medium needs less VRAM.
WHISPER_MODEL=large-v3-turbo
# int8_float16: about 2-3 GB of VRAM on the RTX 2080 Super; float16 for a little more quality.
WHISPER_COMPUTE_TYPE=int8_float16
WHISPER_DEVICE=cuda
WHISPER_BEAM_SIZE=5
# Where the model is kept (about 1.6 GB for turbo, 3 GB for large-v3). Empty = /var/lib/ytp-transcriber.
# On a netboot image, a folder on the server's NVMe over NFS keeps it across boots, e.g.
# WHISPER_MODEL_DIR=/srv/models/whisper  (must be writable by the user ytp-transcriber)
WHISPER_MODEL_DIR=
# Where the sound of the current video is unpacked (16 kHz WAV, ~115 MB per hour). Empty = /tmp.
WORK_DIR=

# Switching off (see worker.py): after IDLE_SHUTDOWN_SECONDS without work; up to
# WAIT_FOR_DOWNLOADS_SECONDS while YouTube downloads may still bring work; after
# UNREACHABLE_SHUTDOWN_SECONDS without any answer from the app.
SHUTDOWN_WHEN_IDLE=1
IDLE_SHUTDOWN_SECONDS=300
WAIT_FOR_DOWNLOADS_SECONDS=1800
UNREACHABLE_SHUTDOWN_SECONDS=900
# Never power off unless the kernel command line shows a network boot (one of NETBOOT_MARKERS).
NETBOOT_ONLY=1
NETBOOT_MARKERS=nfsroot=,root=/dev/nfs,netboot=
# A command that exits 0 while the PC is busy with something else, e.g. the coding agent:
# BUSY_COMMAND=pgrep -x aider
BUSY_COMMAND=
POLL_SECONDS=30
LOG_LEVEL=INFO
