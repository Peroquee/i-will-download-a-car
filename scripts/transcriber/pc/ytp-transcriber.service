# The Whisper worker on the transcription PC (docs/transcription.md). Installed by install.sh
# into the Linux image the PC boots from the network.
[Unit]
Description=youtube-premium: Whisper transcription worker
Documentation=https://github.com/Peroquee/i-will-download-a-car/blob/main/docs/transcription.md
Wants=network-online.target
After=network-online.target nvidia-persistenced.service

[Service]
Type=simple
User=ytp-transcriber
Group=ytp-transcriber
EnvironmentFile=/etc/ytp-transcriber.env
ExecStart=/opt/ytp-transcriber/run.sh
# 77 = "nothing left to do": a clean end, not restarted, and the PC is powered off.
SuccessExitStatus=77
RestartPreventExitStatus=77
ExecStopPost=+/opt/ytp-transcriber/poweroff-if-done.sh
Restart=on-failure
RestartSec=30
# The model cache, unless WHISPER_MODEL_DIR points elsewhere (e.g. the server's NVMe over NFS).
StateDirectory=ytp-transcriber
Environment=HF_HOME=/var/lib/ytp-transcriber/huggingface
PrivateTmp=yes
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=yes

[Install]
WantedBy=multi-user.target
