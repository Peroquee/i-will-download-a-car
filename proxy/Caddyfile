# Reverse proxy for the youtube-premium stack (#29). Caddy 2, plain HTTP on the LAN.
#
# Two listeners. Both check first that the client is inside LAN_SUBNET, judged by the TCP
# connection's own source address (remote_ip). X-Forwarded-For is never read: trusted_proxies
# is not set, and client_ip (which would honour it) is deliberately not used. Then
#   - :8080 (the app) passes the request on: the app has its own accounts (#44);
#   - :8081 (qBittorrent) asks for HTTP basic auth against PROXY_USER / PROXY_PASSWORD_HASH
#     (a bcrypt hash, made by scripts/proxy/set_password.py).
# Only then is the request passed on. Anything that fails answers before it reaches
# the upstream, and an empty LAN_SUBNET, user or hash makes Caddy refuse to start
# (a parse error), so a half-configured proxy never serves anything.
#
# Container ports: 8080 -> the app, 8081 -> the qBittorrent Web UI. The host ports are
# PROXY_PORT / PROXY_QBT_PORT in .env, bound to PROXY_BIND (docker-compose.yml).
# docs/proxy.md explains the design.

{
	# No admin API socket: nothing can reconfigure the proxy at runtime.
	admin off
	# Plain HTTP on the LAN is intended (like the GitLab); there are no certificates.
	auto_https off
}

(lan_only) {
	@outside not remote_ip {$LAN_SUBNET}
	respond @outside "Forbidden" 403

	header -Server
}

# The qBittorrent port keeps the proxy's own login (the app has none of its business there).
(guard) {
	import lan_only

	basic_auth {
		{$PROXY_USER} {$PROXY_PASSWORD_HASH}
	}
}

# The app (#8). Reached over the compose bridge network. Only the LAN check is Caddy's job here
# (#44): the app has its own accounts, login, sessions and permissions, and answers 401 itself.
:8080 {
	log {
		output stdout
		format json
	}
	route {
		import lan_only
		# Nothing of the proxy's own login is ever forwarded (qBittorrent port) and, symmetrically,
		# the app's login cookie stays between the browser and the app.
		reverse_proxy app:8000 {
			header_up -Authorization
		}
	}
}

# qBittorrent's Web UI, which lives in gluetun's network namespace and is therefore
# reached as gluetun:8080 over the bridge. Its own login stays on as a second layer.
# The Host header is passed through unchanged, which is what qBittorrent's CSRF check
# (Origin against Host) needs; the Authorization header is removed (below). qBittorrent's separate Host header validation is switched off
# (seed_config.py): with it on, a Host with port 8081 on a Web UI at 8080 gets a 401.
:8081 {
	log {
		output stdout
		format json
	}
	route {
		import guard
		# qBittorrent 5.3 answers 401 to ANY request that carries an Authorization header (it
		# reads one as API-key auth), so the proxy's basic-auth header must not be forwarded.
		reverse_proxy gluetun:8080 {
			header_up -Authorization
		}
	}
}

# Health check for Docker, reachable only inside the proxy container (loopback, not published).
http://127.0.0.1:8082 {
	bind 127.0.0.1
	respond /health "ok" 200
	respond 404
}
